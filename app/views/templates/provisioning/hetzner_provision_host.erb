<%#
kind: opentofu_script
name: Hetzner provision default
model: ProvisioningTemplate
description: |
  Hetzner OpenTofu script to create vm resource
-%>

<%= terraform_block({ hcloud: { source: 'hetznercloud/hcloud', version: '>= 1.60' } }) %>

provider "hcloud" {
  token = var.password
}

<% if @resource %>
<%= resource_block(@resource) %>

<% elsif @keygen %>
<%- if @ssh_key.present? %>
resource "hcloud_ssh_key" "deploy_key" {
  name       = "<%= @ssh_key.name %>"
  public_key = "<%= @ssh_key.public_key %>"
}
<%- end %>

<% elsif !@dry_run %>
<%- if @ssh_key.present? %>
data "hcloud_ssh_key" "deploy_key" {
  name       = "<%= @ssh_key.name %>"
}
<%- end %>

# Create a new server
resource "hcloud_server" "node1" {
  name        = "<%= @host_name %>"

  <%= vm_attributes(['name', 'image']) %>

<%- if @cr_attrs['image_id'].present? %>
  image = <%= @cr_attrs['image_id'] %>
  <%- if @user_data_filename.present? %>
  user_data = "${file("<%= @user_data_filename %>")}"
  <%- elsif @cr_attrs['user_data'].present? %>
  user_data = <%= @cr_attrs['user_data'] %>
  <%- elsif @ssh_key.present? %>
  ssh_keys = [
    data.hcloud_ssh_key.deploy_key.id
  ]
  <%- end %>
<%- end %>

  <%= build_nics %>

  public_net {
    ipv4_enabled = true
    ipv6_enabled = true
  }
}

<%= build_disks %>

output "vm_attrs" {
  value = {
      identity = hcloud_server.node1.id
      vm_ip_address = hcloud_server.node1.ipv4_address
      vm_ip6_address = hcloud_server.node1.ipv6_address
      vm = hcloud_server.node1
      volumes_attributes = try({
        for k, v in try(hcloud_volume.volumes, {}) : tostring(try(v.id, k)) => {
          id = try(v.id, null)
          name = try(v.name, "volume-${k}")
          size = try(v.size, 20)
          automount = try(v.automount, null)
          format = try(v.format, null)
        } if try(v["_delete"], "0") != "1"
      }, {})
  }
}
<% end %>
