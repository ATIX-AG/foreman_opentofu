<%= field_set_tag _("Common fields"), :id => "compute_ressource_common_field_set" do %>
  <%= select_f f, :opentofu_provider, ForemanOpentofu::ProviderTypeManager.enabled_provider_types, :id, :name, {}, {:label => _("OpenTofu Provider")} %>
  <%= select_f f, :opentofu_template_id, ProvisioningTemplate.of_kind('opentofu_script'), :id, :name, {}, {:label => _("OpenTofu Template")} %>
  <%= text_f f, :url, :help_block => _("127.0.0.1") %>
  <%= text_f f, :user , :help_block => _("e.g. admin") %>
  <%= password_f f, :password, :unset => unset_password? %>
  <%= checkbox_f f, :caching_enabled, :label => _("Enable caching"),
                 :help_inline => _("Cache slow calls to OpenTofu Compute resources to speed up page rendering") %>

<% end %>
<div class="col-md-offset-2">
  <%= test_connection_button_f(f, (true)) %>
</div>
