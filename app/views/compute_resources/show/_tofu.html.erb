<tr>
  <td><%= _('OpenTofu Provider') %></td>
  <td><%= @compute_resource.opentofu_provider %></td>
</tr>
<tr>
  <td><%= _('OpenTofu Template') %></td>
  <td><%= link_to @compute_resource.opentofu_template, edit_provisioning_template_path(@compute_resource.opentofu_template) %></td>
</tr>
<% if @compute_resource.url.present? %>
  <tr>
    <td><%= _('URL') %></td>
    <td><%= @compute_resource.url %></td>
  </tr>
<% end %>
<tr>
  <td><%= _("Caching") %></td>
  <td><%= @compute_resource.caching_enabled ? _("Enabled") : _("Disabled") %></td>
</tr>
<tr>
  <td><%= _('HTTP-Proxy') %></td>
  <td><%= @compute_resource.http_proxy.present? ? link_to(@compute_resource.http_proxy, edit_http_proxy_path(@compute_resource.http_proxy)) : '' %></td>
</tr>
